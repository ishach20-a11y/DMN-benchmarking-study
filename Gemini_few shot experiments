def load_example(file_path: str) -> str:
    if not os.path.exists(file_path):
        raise FileNotFoundError(
            f"Missing file: {file_path}\n"
            "Make sure you uploaded all required files."
        )

    with open(file_path, "r", encoding="utf-8") as f:
        return f.read()

