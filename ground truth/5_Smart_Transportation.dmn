  <decision id="Decision_0irhtak" name="Cooling system adjustment">
    <informationRequirement id="InformationRequirement_07cim97">
      <requiredInput href="#InputData_1jku93y" />
    </informationRequirement>
    <decisionTable id="DecisionTable_0ttydpl">
      <input id="InputClause_081qnoy" label="temperature">
        <inputExpression id="LiteralExpression_0fsaa2j" typeRef="string" />
        <inputValues id="UnaryTests_03ga8xv">
          <text>"high","low","normal"</text>
        </inputValues>
      </input>
      <output id="OutputClause_1cly1od" label="adjustment" typeRef="string">
        <outputValues id="UnaryTests_1tnzzym">
          <text>"increase","decrease","maintain"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_1pd64zr">
        <inputEntry id="UnaryTests_1goys53">
          <text>"high"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0bd2dvg">
          <text>"decrease"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_17nhzz4">
        <inputEntry id="UnaryTests_17021wn">
          <text>"normal"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0cdqbvd">
          <text>"maintain"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_14f2o15">
        <inputEntry id="UnaryTests_0bg0auo">
          <text>"low"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0ebjjkh">
          <text>"increase"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_1jku93y" name="outside temperature" />
  <dmndi:DMNDI>
