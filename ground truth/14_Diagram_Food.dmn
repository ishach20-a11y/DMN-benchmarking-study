  <decision id="Decision_1uyxz48" name="Assess Dinner Situation">
    <informationRequirement id="InformationRequirement_110vgmp">
      <requiredInput href="#InputData_0gkx6hb" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1t3znql">
      <requiredInput href="#InputData_1g2achn" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0atc52e">
      <requiredDecision href="#Decision_1769fpo" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1t3648x">
      <input id="Input_1" label="Hunger Level">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1l8j69m">
          <text>"Low","Medium","High"</text>
        </inputValues>
      </input>
      <input id="InputClause_0k3j8h6" label="Time" biodi:width="192">
        <inputExpression id="LiteralExpression_1cqzd86" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1aany1s">
          <text>"Short","Long"</text>
        </inputValues>
      </input>
      <output id="Output_1" label="Need Level" typeRef="string">
        <outputValues id="UnaryTests_0xlggk6">
          <text>"Urgent","Light","Normal","Full meal"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_1agdfqi">
        <inputEntry id="UnaryTests_1t38y7e">
          <text>"Low"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0alj6c9">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0vtdyoc">
          <text>"Light"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0h3of62">
        <inputEntry id="UnaryTests_1lpduj0">
          <text>"Medium"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1193f3g">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0ro1dwx">
          <text>"Normal"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_06g1w1m">
        <inputEntry id="UnaryTests_173jauj">
          <text>"High"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_06e1vm7">
          <text>"Short"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1sx7kk5">
          <text>"Urgent"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1twv7gj">
        <inputEntry id="UnaryTests_17janh1">
          <text>"High"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_035w2z4">
          <text>"Long"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_15hlokx">
          <text>"Full meal"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
