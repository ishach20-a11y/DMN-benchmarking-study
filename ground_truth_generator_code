# ── 3. Prompt Builder ──────────────────────────────────────────────────────────
def build_prompt(description: str) -> str:
    return f"""<s>[INST] You are a DMN expert. Your task is to extract the complete Decision Model from the text.

1. Identify all Input Data and Decision nodes (DRD).
2. For each decision, provide a Decision Table in Markdown format.
3. The table must have columns for Inputs and a column for the Output.
4. Clearly label each table with a heading like: ## Decision: <decision name>

Text: '{description}' [/INST]</s>"""

# ── 4. Markdown Table Parser ───────────────────────────────────────────────────
def parse_markdown_tables(text: str) -> list[dict]:
    tables = []
    sections = re.split(r'#{1,3}\s*Decision[:\s]+', text, flags=re.IGNORECASE)

    for section in sections[1:]:
        lines = section.strip().splitlines()
        if not lines:
            continue

        decision_name = lines[0].strip().strip("*_").strip()
        table_lines   = [l for l in lines if l.strip().startswith("|")]

        if len(table_lines) < 3:
            continue

        headers = [h.strip() for h in table_lines[0].split("|") if h.strip()]
        rows = []
        for row_line in table_lines[2:]:
            cells = [c.strip() for c in row_line.split("|") if c.strip()]
            if cells and not all(re.match(r'^-+$', c) for c in cells):
                rows.append(cells)

        if headers and rows:
            tables.append({"name": decision_name, "headers": headers, "rows": rows})

    return tables

# ── 5. DMN XML Builder ─────────────────────────────────────────────────────────
def sanitize_id(name: str) -> str:
    return re.sub(r'[^a-zA-Z0-9_-]', '_', name).strip('_')

def build_dmn_xml(desc_id: str, tables: list[dict]) -> str:
    NS    = "https://www.omg.org/spec/DMN/20191111/MODEL/"
    DMNDI = "https://www.omg.org/spec/DMN/20191111/DMNDI/"
    DC    = "http://www.omg.org/spec/DMN/20180521/DC/"
    ET.register_namespace("",      NS)
    ET.register_namespace("dmndi", DMNDI)
    ET.register_namespace("dc",    DC)

    definitions = ET.Element("definitions", {
        "xmlns":           NS,
        "xmlns:dmndi":     DMNDI,
        "xmlns:dc":        DC,
        "id":              f"definitions_{sanitize_id(desc_id)}",
        "name":            desc_id,
        "namespace":       "http://camunda.org/schema/1.0/dmn",
        "exporter":        "LLM DMN Generator",
        "exporterVersion": "1.0",
    })

    for table in tables:
        table_id       = f"decision_{sanitize_id(table['name'])}"
        input_headers  = table["headers"][:-1]
        output_header  = table["headers"][-1]

        decision_el = ET.SubElement(definitions, "decision", {
            "id": table_id, "name": table["name"]
        })
        dt = ET.SubElement(decision_el, "decisionTable", {
            "id": f"dt_{sanitize_id(table['name'])}", "hitPolicy": "UNIQUE"
        })

        for i, header in enumerate(input_headers):
            inp = ET.SubElement(dt, "input", {
                "id": f"input_{sanitize_id(table['name'])}_{i}", "label": header
            })
            ET.SubElement(inp, "inputExpression", {
                "id":      f"inputExpr_{sanitize_id(table['name'])}_{i}",
                "typeRef": "string",
            }).text = header.lower().replace(" ", "_")

        ET.SubElement(dt, "output", {
            "id":      f"output_{sanitize_id(table['name'])}",
            "label":   output_header,
            "name":    output_header.lower().replace(" ", "_"),
            "typeRef": "string",
        })

        for r_idx, row in enumerate(table["rows"]):
            rule   = ET.SubElement(dt, "rule", {
                "id": f"rule_{sanitize_id(table['name'])}_{r_idx}"
            })
            padded = (row + [""] * len(table["headers"]))[:len(table["headers"])]

            for c_idx, cell in enumerate(padded[:-1]):
                ET.SubElement(rule, "inputEntry", {
                    "id": f"ie_{sanitize_id(table['name'])}_{r_idx}_{c_idx}"
                }).text = f'"{cell}"' if cell else ""

            ET.SubElement(rule, "outputEntry", {
                "id": f"oe_{sanitize_id(table['name'])}_{r_idx}"
            }).text = f'"{padded[-1]}"' if padded[-1] else ""

    raw  = ET.tostring(definitions, encoding="unicode", xml_declaration=False)
    pretty = minidom.parseString(raw).toprettyxml(indent="  ")
    return '<?xml version="1.0" encoding="UTF-8"?>\n' + "\n".join(pretty.splitlines()[1:])

# ── 6. Generate Ground Truth ───────────────────────────────────────────────────
for desc_id, desc_info in descriptions_needing_gt.items():
    print(f"▶ Generating ground truth for: {desc_id}")
    prompt   = build_prompt(desc_info["text"])

    output   = pipe(
        prompt,
        max_new_tokens=2048,
        do_sample=False,          # greedy — fully deterministic
        temperature=None,
    )

    response = output[0]["generated_text"][len(prompt):].strip()
    tables   = parse_markdown_tables(response)

    if tables:
        xml_str  = build_dmn_xml(desc_id, tables)
        xml_path = f"ground_truth/xml/{desc_id}.xml"
        with open(xml_path, "w", encoding="utf-8") as f:
            f.write(xml_str)
        print(f"  ✅ Saved → {xml_path}  ({len(tables)} table(s))")
    else:
        print(f"  ⚠️  No tables parsed — printing raw response for manual inspection:")
        print(response)

print("\n✅ Ground truth generation complete.")
