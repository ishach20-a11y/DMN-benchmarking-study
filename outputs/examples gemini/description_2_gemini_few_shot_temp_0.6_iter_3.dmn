          <text></text>
        </inputExpression>
      </input>
      <input id="Input_Garden" label="has garden">
        <inputExpression id="Expr_Garden" typeRef="boolean">
          <text></text>
        </inputExpression>
      </input>
      <output id="Output_Pet" label="pet adopted" typeRef="string">
        <outputValues id="Values_Pet">
          <text>"none","fish","cat","dog"</text>
        </outputValues>
      </output>
      <rule id="Rule_1">
        <inputEntry id="In_1_1">
          <text>true</text>
