      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_0j1k2l3" dmnElementRef="InformationRequirement_0d4e5f6">
        <di:waypoint x="250" y="227" />
        <di:waypoint x="250" y="200" />
        <di:waypoint x="250" y="180" />
      </dmndi:DMNEdge>
