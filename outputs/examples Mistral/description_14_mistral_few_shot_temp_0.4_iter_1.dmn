        <dc:Bounds height="45" width="125" x="327" y="227" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_0p7q8r9" dmnElementRef="InformationRequirement_0m1n2o3">
        <di:waypoint x="390" y="227" />
