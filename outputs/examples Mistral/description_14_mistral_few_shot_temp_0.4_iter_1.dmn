        <di:waypoint x="110" y="227" />
        <di:waypoint x="205" y="200" />
        <di:waypoint x="205" y="180" />
      </dmndi:DMNEdge>
      <dmndi:DMNShape id="DMNShape_0g7h8i9" dmnElementRef="InputData_1j7k8l9">
