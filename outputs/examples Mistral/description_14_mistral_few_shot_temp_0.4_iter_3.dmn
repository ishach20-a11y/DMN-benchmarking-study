        <dc:Bounds height="45" width="125" x="47" y="227" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_1d5e6f7" dmnElementRef="InformationRequirement_0a1b2c3">
        <di:waypoint x="110" y="227" />
        <di:waypoint x="205" y="200" />
        <di:waypoint x="205" y="180" />
      </dmndi:DMNEdge>
      <dmndi:DMNShape id="DMNShape_1g8h9i0" dmnElementRef="InputData_1i7j8k9">
        <dc:Bounds height="45" width="125" x="187" y="227" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_1j1k2l3" dmnElementRef="InformationRequirement_0d4e5f6">
        <di:waypoint x="250" y="227" />
        <di:waypoint x="250" y="200" />
        <di:waypoint x="250" y="180" />
      </dmndi:DMNEdge>
      <dmndi:DMNShape id="DMNShape_1m4n5o6" dmnElementRef="InputData_1l0m1n2">
        <dc:Bounds height="45" width="125" x="327" y="227" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_1p7q8r9" dmnElementRef="InformationRequirement_0g7h8i9">
        <di:waypoint x="390" y="227" />
        <di:waypoint x="295" y="200" />
        <di:waypoint x="295" y="180" />
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
