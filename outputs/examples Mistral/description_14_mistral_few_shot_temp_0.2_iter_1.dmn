  <decision id="Decision_1y3x7f2" name="meal decision">
    <informationRequirement id="InformationRequirement_0a1b2c3">
      <requiredInput href="#InputData_1h4g5i6" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0d4e5f6">
      <requiredInput href="#InputData_1j7k8l9" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0m1n2o3">
      <requiredInput href="#InputData_1p4q5r6" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1s7t8u9" hitPolicy="UNIQUE">
      <input id="Input_1" label="hunger level">
        <inputExpression id="InputExpression_1v2w3x4" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1y5z6a7">
          <text>"low","medium","high"</text>
        </inputValues>
      </input>
      <input id="Input_2" label="time available">
        <inputExpression id="InputExpression_1b8c9d0" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1e2f3g4">
          <text>"enough","not enough"</text>
        </inputValues>
      </input>
      <input id="Input_3" label="financial situation">
        <inputExpression id="InputExpression_1h5i6j7" typeRef="number">
          <text></text>
        </inputExpression>
      </input>
      <output id="Output_1" label="meal decision" typeRef="string">
        <outputValues id="UnaryTests_1k2l3m4">
          <text>"snack","cook","order","light meal","normal meal","full meal","urgent meal"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_1n5o6p7">
        <inputEntry id="UnaryTests_1q8r9s0">
          <text>"low"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1t2u3v4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1w5x6y7">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1z9a0b1">
          <text>"snack"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1c2d3e4">
        <inputEntry id="UnaryTests_1f5g6h7">
          <text>"medium"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1i8j9k0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1l2m3n4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1o5p6q7">
          <text>"normal meal"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1r8s9t0">
        <inputEntry id="UnaryTests_1u2v3w4">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1x5y6z7">
          <text>"not enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1a9b0c1">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1d2e3f4">
          <text>"urgent meal"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1g5h6i7">
        <inputEntry id="UnaryTests_1j8k9l0">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1m2n3o4">
          <text>"enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1p5q6r7">
          <text>&lt; 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1s8t9u0">
          <text>"cook"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1v2w3x4">
        <inputEntry id="UnaryTests_1y5z6a7">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1b8c9d0">
          <text>"enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1e2f3g4">
          <text>&gt;= 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1h5i6j7">
          <text>"order"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1k2l3m4">
        <inputEntry id="UnaryTests_1n5o6p7">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1q8r9s0">
          <text>"not enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1t2u3v4">
          <text>&lt; 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1w5x6y7">
          <text>"snack"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_1h4g5i6" name="hunger level" />
  <inputData id="InputData_1j7k8l9" name="time available" />
  <inputData id="InputData_1p4q5r6" name="financial situation" />
