  <decision id="Decision_1y3x7f9" name="meal decision">
    <informationRequirement id="InformationRequirement_0a1b2c3">
      <requiredInput href="#InputData_1h4g5i6" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0d4e5f6">
      <requiredInput href="#InputData_1j7k8l9" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0m1n2o3">
      <requiredInput href="#InputData_1p4q5r6" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1s2t3u4" hitPolicy="UNIQUE">
      <input id="Input_1" label="hunger level">
        <inputExpression id="InputExpression_1v2w3x4" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1y2z3a4">
          <text>"low","medium","high"</text>
        </inputValues>
      </input>
      <input id="Input_2" label="time available">
        <inputExpression id="InputExpression_1b2c3d4" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1e2f3g4">
          <text>"enough","not enough"</text>
        </inputValues>
      </input>
      <input id="Input_3" label="financial situation">
        <inputExpression id="InputExpression_1h2i3j4" typeRef="number">
          <text></text>
        </inputExpression>
      </input>
      <output id="Output_1" label="meal decision" typeRef="string">
        <outputValues id="UnaryTests_1k2l3m4">
          <text>"snack","cook","order","light meal","normal meal","full meal"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_1n2o3p4">
        <inputEntry id="UnaryTests_1q2r3s4">
          <text>"low"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1t2u3v4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1w2x3y4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1z2a3b4">
          <text>"snack"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1c2d3e4">
        <inputEntry id="UnaryTests_1f2g3h4">
          <text>"medium"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1i2j3k4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1l2m3n4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1o2p3q4">
          <text>"normal meal"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1r2s3t4">
        <inputEntry id="UnaryTests_1u2v3w4">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1x2y3z4">
          <text>"not enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1a2b3c4">
          <text>&lt; 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1d2e3f4">
          <text>"snack"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1g2h3i4">
        <inputEntry id="UnaryTests_1j2k3l4">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1m2n3o4">
          <text>"not enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1p2q3r4">
          <text>&gt;= 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1s2t3u4">
          <text>"order"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1v2w3x4">
        <inputEntry id="UnaryTests_1y2z3a5">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1b2c3d5">
          <text>"enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1e2f3g5">
          <text>&lt; 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1h2i3j5">
          <text>"cook"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1k2l3m5">
        <inputEntry id="UnaryTests_1n2o3p5">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1q2r3s5">
          <text>"enough"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1t2u3v5">
          <text>&gt;= 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1w2x3y5">
          <text>"order"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_1h4g5i6" name="hunger level" />
  <inputData id="InputData_1j7k8l9" name="time available" />
  <inputData id="InputData_1p4q5r6" name="financial situation" />
