  <decision id="Decision_1x7y2zp" name="meal decision">
    <informationRequirement id="InformationRequirement_0a1b2c3">
      <requiredInput href="#InputData_1h4g5f6" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0d4e5f6">
      <requiredInput href="#InputData_1g7h8i9" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0j1k2l3">
      <requiredInput href="#InputData_1m4n5o6" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1p7q8r9" hitPolicy="UNIQUE">
      <input id="Input_1a2b3c" label="hunger level">
        <inputExpression id="InputExpression_1d4e5f" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1g7h8i">
          <text>"low","medium","high"</text>
        </inputValues>
      </input>
      <input id="InputClause_1j9k0l" label="time available">
        <inputExpression id="LiteralExpression_1m2n3o" typeRef="boolean">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_1p4q5r" label="financial situation">
        <inputExpression id="LiteralExpression_1s6t7u" typeRef="number">
          <text></text>
        </inputExpression>
      </input>
      <output id="Output_1v8w9x" label="meal decision" typeRef="string">
        <outputValues id="UnaryTests_1y0z1a">
          <text>"snack","cook","order","light meal","normal meal","full meal","urgent meal"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_1b2c3d4">
        <inputEntry id="UnaryTests_1e5f6g7">
          <text>"low"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1h8i9j0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1k1l2m3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1n4o5p6">
          <text>"snack"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1q7r8s9">
        <inputEntry id="UnaryTests_1t0u1v2">
          <text>"medium"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1w3x4y5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1z6a7b8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1c9d0e1">
          <text>"normal meal"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1f2g3h4">
        <inputEntry id="UnaryTests_1i5j6k7">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1l8m9n0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1o1p2q3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1r4s5t6">
          <text>"full meal"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1u7v8w9">
        <inputEntry id="UnaryTests_1x0y1z2">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1a3b4c5">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1d6e7f8">
          <text>&lt; 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1g9h0i1">
          <text>"snack"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1j2k3l4">
        <inputEntry id="UnaryTests_1m5n6o7">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1p8q9r0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1s1t2u3">
          <text>&lt; 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1v4w5x6">
          <text>"cook"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1y7z8a9">
        <inputEntry id="UnaryTests_1b0c1d2">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1e3f4g5">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1h6i7j8">
          <text>&gt;= 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1k9l0m1">
          <text>"order"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1n2o3p4">
        <inputEntry id="UnaryTests_1q5r6s7">
          <text>"high"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1t8u9v0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1w1x2y3">
          <text>&gt;= 10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1z4a5b6">
          <text>"order"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_1h4g5f6" name="hunger level" />
  <inputData id="InputData_1g7h8i9" name="time available" />
  <inputData id="InputData_1m4n5o6" name="financial situation" />
