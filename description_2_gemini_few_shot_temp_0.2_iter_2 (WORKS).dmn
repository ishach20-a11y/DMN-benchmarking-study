      <rule id="DecisionRule_10">
        <inputEntry id="UnaryTests_10_1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_10_2">
          <text>"lot"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_10_3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_10_4">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_10">
          <text>"cat"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_11">
        <inputEntry id="UnaryTests_11_1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_11_2">
          <text>"average"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_11_3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_11_4">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_11">
          <text>"cat"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_12">
        <inputEntry id="UnaryTests_12_1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_12_2">
          <text>"lot"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_12_3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_12_4">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_12">
          <text>"cat"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_Allergies" name="allergies" />
  <inputData id="InputData_Time" name="time available" />
  <inputData id="InputData_Kids" name="have kids" />
  <inputData id="InputData_Garden" name="have garden" />
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape id="Decision_PetAdoption_di" dmnElementRef="Decision_PetAdoption">
